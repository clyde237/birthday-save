{
  "expo": {
    "name": "Birthday-save",
    "slug": "birthday-save",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/birthday-save-brand/expo/icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/birthday-save-brand/expo/icon-1024.png",
        "dark": "./assets/birthday-save-brand/expo/ios-dark-1024.png",
        "tinted": "./assets/birthday-save-brand/expo/ios-tinted-1024.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/birthday-save-brand/expo/android-foreground-1024.png",
        "backgroundColor": "#AE1F4D",
        "monochromeImage": "./assets/birthday-save-brand/expo/android-monochrome-1024.png"
      },
      "package": "com.birthdaysave.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/birthday-save-brand/expo/notification-96.png",
          "color": "#AE1F4D"
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Birthday-save utilise vos photos pour illustrer les fiches de vos proches.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/birthday-save-brand/expo/splash-screen-1024.png",
          "backgroundColor": "#B12552",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "397a83db-784f-4240-a144-cd2957aa446a"
      }
    }
  }
}
